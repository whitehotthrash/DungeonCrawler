Rem This governs dice rolls, hit and damage effects

GLOBAL playerHealth#, enemyHealth#
GLOBAL attackTrigger, hasAttacked, hasHit, isPlayerKilled, isEnemyKilled
GLOBAL hasRolledThisTurn, rollResult#, damage#

FUNCTION Init_HP()
	playerHealth#     = 10
	isPlayerKilled    = 0
	enemyHealth#      = 10
	isEnemyKilled     = 0
	hasAttacked       = 0
	attackTrigger     = 0
	rollResult#       = 0
	hasRolledThisTurn = 0
	hasHit            = 0
	damage#           = 4
ENDFUNCTION

FUNCTION Take_Damage(entityId#)
	IF entityId# = playerId#
		playerHealth# = playerHealth# - 4
		IF playerHealth# < 0
			playerHealth# = 0
			isPlayerKilled = 1
			PRINT "LOSE"
		ENDIF
	ENDIF
		
	IF entityId# = enemyId#
		enemyHealth# = enemyHealth# - 0.1
		IF enemyHealth# < 0
			enemyHealth# = 0
			isEnemyKilled = 1
			PRINT "WIN"
		ENDIF
	ENDIF
ENDFUNCTION

FUNCTION Attack_Roll(attackerId, defenderId)
	hasAttacked = 0
	IF isAttackingEnemy = 1 AND attackTrigger = 0
		hasAttacked = 1
		hasRolledThisTurn = 0
		attackTrigger = 1
	ELSE
		hasAttacked = 0
	ENDIF

ENDFUNCTION

FUNCTION Hit_Roll()
	hasHit = 0
	IF attackTrigger = 1 AND hasAttacked = 1 AND hasRolledThisTurn = 0
		rollOne# = RND(5) + 1
		rollTwo# = RND(5) + 1
		rollResult# = rollOne# + rollTwo#
	
		IF rollResult# > 6
			hasHit = 1
			Take_Damage(enemyId#)
		ENDIF
		
		attackTrigger = 0
		hasAttacked   = 0
	ENDIF

	PRINT hasAttacked,", ",attackTrigger,", ", hasHit,", ", hasRolledThisTurn,", ", rollResult#,", ", enemyHealth#
ENDFUNCTION