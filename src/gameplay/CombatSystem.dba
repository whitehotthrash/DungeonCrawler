Rem This governs dice rolls, hit and damage effects

GLOBAL playerHealth#, enemyHealth#
GLOBAL hasAttacked, hasHit, isPlayerKilled, isEnemyKilled
GLOBAL hasRolledThisTurn, rollResult#, damage#

FUNCTION Init_HP()
	playerHealth#     = 10
	isPlayerKilled    = 0
	enemyHealth#      = 10
	isEnemyKilled     = 0
	hasAttacked       = 0
	rollResult#       = 0
	hasRolledThisTurn = 0
	hasHit            = 0
	damage#           = 4
ENDFUNCTION

FUNCTION Take_Damage(entityId#)
	IF entityId# = playerId#
		playerHealth# = playerHealth# - 4
		IF playerHealth# < 0
			playerHealth# = 0
			isPlayerKilled = 1
			PRINT "LOSE"
		ENDIF
	ENDIF
		
	IF entityId# = enemyId#
		enemyHealth# = enemyHealth# - 0.1
		IF enemyHealth# < 0
			enemyHealth# = 0
			isEnemyKilled = 1
			PRINT "WIN"
		ENDIF
	ENDIF
ENDFUNCTION

FUNCTION Click_To_Attack()

		hasAttacked       = 0
		hasHit            = 0
		hasRolledThisTurn = 0
		
		IF MOUSECLICK() = 1 AND hasAttacked = 0
			hasAttacked = 1
			hasRolledThisTurn = 0
			
			IF hasAttacked = 1 AND MOUSECLICK() = 0
				rollOne# = RND(5) + 1
				rollTwo# = RND(5) + 1
				rollResult# = rollOne# + rollTwo#
				hasRolledThisTurn = 1
				IF rollResult# > 6
					hasHit = 1
					Take_Damage(enemyId#)
					PLAY OBJECT playerId#, 55, 75
					SET OBJECT SPEED playerId#, 45
				ENDIF
				
				hasAttacked = 0
			ENDIF
		ENDIF
	PRINT hasAttacked,", ", hasHit,", ", hasRolledThisTurn,", ", rollResult#,", ", enemyHealth#
	
ENDFUNCTION

